{
  "name": "salted-focaccia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write src tests docs README.md AGENTS.md",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "typegen": "sanity schema extract --enforce-required-fields --force && sanity typegen generate",
    "prebuild": "npm run typegen",
    "cms:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "cms:qa": "node --env-file-if-exists=.env.local --import tsx scripts/cms-qa.ts",
    "cms:migrate-navigation": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-navigation.ts",
    "cms:migrate-product-filters": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-product-filters.ts",
    "cms:migrate-inactive-products": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-inactive-products.ts",
    "cms:split-navigation": "node --env-file-if-exists=.env.local --import tsx scripts/split-navigation.ts"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@next/third-parties": "^16.4.3",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.14.1",
    "@sanity/image-url": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "next-sanity": "^13.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "sanity": "^6.22.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@sanity/preview-url-secret": "^4.1.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.9.1"
    },
    "@module-federation/dts-plugin": {
      "undici": "^7.30.1"
    }
  }
}
