NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 2 — Sanity editorial content
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01
SANITY_API_READ_TOKEN=
# Optional server-only compatibility alias used for reads and initial seeding.
# Prefer a Viewer read token after setup; never prefix this with NEXT_PUBLIC_.
SANITY_API_TOKEN=
# Temporary migration token. Remove after seeding. Never put in Vercel/frontend.
SANITY_API_WRITE_TOKEN=

# Phase 3 — server-only commerce; Stripe checkout with test keys only

# Database
DATABASE_URL=
# Direct connection used only for Drizzle migrations
DATABASE_URL_UNPOOLED=
# Separate migrated QA branch; never the app database
TEST_DATABASE_URL=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
EMAIL_FROM=feedme@saltedfocaccia.com

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Rate limiting
# Private random secret (32+ characters) for checkout/unsubscribe request buckets
RATE_LIMIT_SECRET=

# Dedicated, stable server-only secret (32+ random characters) for future
# newsletter unsubscribe links. Email-form opt-out does not require this key.
MARKETING_UNSUBSCRIBE_SECRET=
